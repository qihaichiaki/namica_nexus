{
  "name": "namica-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n host,web \"tsx watch apps/host/src/main.ts --dev\" \"vite --config apps/web/vite.config.ts\"",
    "dev:host": "tsx watch apps/host/src/main.ts --dev",
    "codex:login": "tsx apps/host/src/codex-login.ts",
    "build": "npm run check && tsc -p tsconfig.host.json && vite build --config apps/web/vite.config.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/apps/host/src/main.js",
    "test": "vitest run",
    "test:live": "node tests/live-smoke.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "fastify": "^5.6.0",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.12"
  }
}
